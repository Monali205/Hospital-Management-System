# Hospital Management System Environment Configuration Template
# 
# INSTRUCTIONS:
# 1. Go to https://www.mongodb.com/cloud/atlas
# 2. Create a free account and M0 cluster
# 3. Get your connection string
# 4. Copy this file and rename it to .env
# 5. Replace YOUR-CONNECTION-STRING with your actual MongoDB URI
# 6. Save and start the server

# MongoDB Connection String
# Format: mongodb+srv://username:password@cluster0.mongodb.net/database_name?retryWrites=true&w=majority
# Get yours from MongoDB Atlas: https://www.mongodb.com/cloud/atlas
MONGODB_URI=mongodb+srv://YOUR-USERNAME:YOUR-PASSWORD@YOUR-CLUSTER.mongodb.net/hospital_management?retryWrites=true&w=majority

# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Secret (Change this to a random string in production)
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_12345

# Application Name (Optional)
APP_NAME=Hospital Management System
APP_VERSION=1.0.0
